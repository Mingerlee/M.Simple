<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.html" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent><remove fileExtension=".nupkg" /><mimeMap fileExtension=".nupkg" mimeType="application/octet-stream" /></staticContent>
    <httpProtocol><customHeaders><remove name="X-Content-Type-Options" /><add name="X-Content-Type-Options" value="nosniff" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
